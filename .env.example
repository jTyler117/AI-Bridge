# Copy this file to ".env" and fill in your keys. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Default models. The app lets you pick per session; these are just the starting values.
# Claude: claude-opus-5-5 | claude-sonnet-5-5 | claude-haiku-5-5 | claude-fable-5-1
# OpenAI: gpt-6.1-sol | gpt-6-sol | gpt-5.6-sol | gpt-6-luna | gpt-5.6-terra | gpt-5.6-luna
# (the app's "Fetch from my accounts" button lists exactly what your keys can use)
CLAUDE_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-5.6-sol

# Safety mode: approval (default, you confirm writes/scripts/scene edits) | autonomous | readonly
BRIDGE_MODE=approval
# Seconds an approval request waits for you before it counts as "no"
BRIDGE_APPROVAL_TIMEOUT=120

# Blender MCP addon socket (defaults match the addon)
BLENDER_HOST=localhost
BLENDER_PORT=9876
# Which Blender add-on is on that port: auto (detects it) | official (Blender Lab MCP add-on) | legacy (ahujasid blender-mcp)
BLENDER_PROTOCOL=auto

# Optional: where shared files, backups, screenshots, state live
# BRIDGE_WORKSPACE=C:\ai-bridge-workspace

# Budget, per-agent permissions and prices are set in the app (Settings).
# They're stored in workspace/state.json, not here.

# Subscription mode needs no keys at all: install Claude Code / the Codex CLI, sign in, and pick "My plan" in the app.
# Optional overrides if the CLIs aren't on your PATH:
# CLAUDE_BIN=C:\path\to\claude.exe
# CODEX_BIN=C:\path\to\codex.cmd
# BRIDGE_CLI_TIMEOUT=900
